# MongoDB Connection
MONGODB_URI=

# Server Configuration
PORT=5001
NODE_ENV=development

# Gmail Configuration for Email Sending
GMAIL_EMAIL=
GMAIL_APP_PASSWORD=
VITE_API_URL=

# Signs login session cookies. Keep secret. If it changes, everyone gets logged out.
SESSION_SECRET=
# Required to call POST /api/recover-admin (creates an admin account when none exists).
# Keep secret — pass it as the "recoverySecret" field in that request.
ADMIN_RECOVERY_SECRET=

# Cloudflare Turnstile ("I'm not a robot" widget) on the Login/Register forms.
# Site key is public — safe to expose in the frontend bundle.
VITE_TURNSTILE_SITE_KEY=
# Secret key is backend-only. Never prefix with VITE_ or import it from src/.
TURNSTILE_SECRET_KEY=
